modules = ["python-3.12"]
run = "python -m streamlit run apps/streamlit/app.py --server.address 0.0.0.0 --server.port 8501"

[deployment]
build = ["sh", "-c", "pip install -r apps/streamlit/requirements.txt"]
run = ["sh", "-c", "python -m streamlit run apps/streamlit/app.py --server.address 0.0.0.0 --server.port 8501"]

[[ports]]
localPort = 8501
externalPort = 80
